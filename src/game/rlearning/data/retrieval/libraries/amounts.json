{
  "_meta": {
    "version": "1.0.0",
    "description": "Generic amount / magnitude phrase library. Slot-level only — no card IDs. Fills {amount}, {p}, {t}, {n} at compose time; effect verbs stay in effects.json.",
    "composition_rule": "Pick an amount phrase to fill numeric slots on an effect. Prefer N_1..N_5 when the parsed value is known; use FIXED with {n} for other integers.",
    "card_mapping": "Per-card numeric bindings live in parsed_cards.jsonl (parser output), not in this library.",
    "phrase_target_per_slot": 20,
    "phrase_style_balance": "~5 oracle_template, ~7 shorthand, ~8 natural_language per slot",
    "placeholders": {
      "n": "integer amount",
      "word_n": "spelled number (one, two, three, ...)",
      "p": "power delta",
      "t": "toughness delta"
    },
    "pool_note": "Pool numeric mass is concentrated on 1–5; N_1..N_5 are first-class slots for graded relevance."
  },
  "types": {
    "N_1": {
      "label": "Amount 1",
      "kind": "fixed",
      "value": 1,
      "confusable_with": [
        "N_2",
        "FIXED"
      ]
    },
    "N_2": {
      "label": "Amount 2",
      "kind": "fixed",
      "value": 2,
      "confusable_with": [
        "N_1",
        "N_3",
        "FIXED"
      ]
    },
    "N_3": {
      "label": "Amount 3",
      "kind": "fixed",
      "value": 3,
      "confusable_with": [
        "N_2",
        "N_4",
        "FIXED"
      ]
    },
    "N_4": {
      "label": "Amount 4",
      "kind": "fixed",
      "value": 4,
      "confusable_with": [
        "N_3",
        "N_5",
        "FIXED"
      ]
    },
    "N_5": {
      "label": "Amount 5",
      "kind": "fixed",
      "value": 5,
      "confusable_with": [
        "N_4",
        "FIXED"
      ]
    },
    "FIXED": {
      "label": "Fixed Amount Template",
      "kind": "fixed",
      "placeholders": [
        "{n}",
        "{word_n}"
      ],
      "note": "Fill {n} / {word_n} at compose time for any integer.",
      "confusable_with": [
        "VARIABLE_X",
        "EQUAL_COUNT"
      ]
    },
    "BUFF_PT": {
      "label": "Power/Toughness Pair",
      "kind": "pair",
      "placeholders": [
        "{p}",
        "{t}"
      ],
      "confusable_with": [
        "COUNTERS_N",
        "FIXED"
      ]
    },
    "COUNTERS_N": {
      "label": "+1/+1 Counter Count",
      "kind": "fixed",
      "placeholders": [
        "{n}"
      ],
      "confusable_with": [
        "BUFF_PT",
        "N_1"
      ]
    },
    "EQUAL_POWER": {
      "label": "Equal to Power",
      "kind": "scaled",
      "confusable_with": [
        "EQUAL_TOUGHNESS",
        "EQUAL_LIFE",
        "VARIABLE_X"
      ]
    },
    "EQUAL_TOUGHNESS": {
      "label": "Equal to Toughness",
      "kind": "scaled",
      "confusable_with": [
        "EQUAL_POWER",
        "EQUAL_LIFE"
      ]
    },
    "EQUAL_LIFE": {
      "label": "Equal to Life Total",
      "kind": "scaled",
      "confusable_with": [
        "EQUAL_POWER",
        "THAT_MUCH"
      ]
    },
    "EQUAL_COUNT": {
      "label": "Equal to Board Count / For Each",
      "kind": "scaled",
      "confusable_with": [
        "VARIABLE_X",
        "FIXED"
      ]
    },
    "VARIABLE_X": {
      "label": "Variable X",
      "kind": "variable",
      "confusable_with": [
        "FIXED",
        "EQUAL_COUNT"
      ]
    },
    "DIVIDED": {
      "label": "Divided Among Targets",
      "kind": "distribution",
      "confusable_with": [
        "FIXED",
        "THAT_MUCH"
      ]
    },
    "THAT_MUCH": {
      "label": "That Much / Mirrored Amount",
      "kind": "referential",
      "confusable_with": [
        "EQUAL_LIFE",
        "FIXED"
      ]
    }
  },
