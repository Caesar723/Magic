{
  "_meta": {
    "version": "1.0.0",
    "description": "Generic duration / timing-window phrase library. Slot-level only — no card IDs. Describes how long an effect lasts; triggers that schedule delays also appear in triggers.json.",
    "composition_rule": "Attach one duration phrase to a binding when the effect is not one-shot. Do not put effect verbs inside duration phrases.",
    "card_mapping": "Per-card duration bindings live in parsed_cards.jsonl (parser output), not in this library.",
    "phrase_target_per_slot": 20,
    "phrase_style_balance": "~5 oracle_template, ~7 shorthand, ~8 natural_language per slot",
    "overlap_with_triggers": "NEXT_END_STEP and NEXT_MAIN_PHASE also exist as trigger/delayed slots. Use duration when attaching timing to an effect; use trigger when the clause is the ability's firing condition."
  },
  "types": {
    "UNTIL_EOT": {
      "label": "Until End of Turn",
      "kind": "temporary",
      "confusable_with": [
        "THIS_TURN",
        "PERMANENT"
      ]
    },
    "THIS_TURN": {
      "label": "This Turn",
      "kind": "temporary",
      "note": "Restriction or window within the current turn; often overlaps UNTIL_EOT in retrieval.",
      "confusable_with": [
        "UNTIL_EOT",
        "INSTANT"
      ]
    },
    "NEXT_END_STEP": {
      "label": "Next End Step",
      "kind": "delayed",
      "confusable_with": [
        "UNTIL_EOT",
        "NEXT_MAIN_PHASE"
      ]
    },
    "DONT_UNTAP_NEXT": {
      "label": "Skip Next Untap",
      "kind": "delayed",
      "confusable_with": [
        "UNTIL_EOT",
        "NEXT_END_STEP"
      ]
    },
    "AS_LONG_AS_CONTROL": {
      "label": "As Long As You Control",
      "kind": "conditional",
      "confusable_with": [
        "UNTIL_LEAVES",
        "PERMANENT"
      ]
    },
    "UNTIL_LEAVES": {
      "label": "Until Leaves Battlefield",
      "kind": "conditional",
      "confusable_with": [
        "AS_LONG_AS_CONTROL",
        "PERMANENT"
      ]
    },
    "PERMANENT": {
      "label": "Permanent / No Expiry",
      "kind": "permanent",
      "confusable_with": [
        "UNTIL_EOT",
        "THIS_TURN"
      ]
    },
    "INSTANT": {
      "label": "Immediate / One-Shot",
      "kind": "instant",
      "confusable_with": [
        "THIS_TURN",
        "UNTIL_EOT"
      ]
    },
    "NEXT_MAIN_PHASE": {
      "label": "Next Main Phase",
      "kind": "delayed",
      "confusable_with": [
        "NEXT_END_STEP"
      ]
    },
    "EXTRA_TURN": {
      "label": "Extra Turn Timing",
      "kind": "turn_structure",
      "confusable_with": [
        "THIS_TURN",
        "NEXT_MAIN_PHASE"
      ]
    }
  },
